{
  "name": "taskflow-backend",
  "version": "0.0.0",
  "private": true,
  "description": "TaskFlow API (NestJS)",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "migration:generate": "npm run build && typeorm -d dist/database/data-source.js migration:generate",
    "migration:run": "npm run build && typeorm -d dist/database/data-source.js migration:run",
    "migration:revert": "npm run build && typeorm -d dist/database/data-source.js migration:revert",
    "migration:show": "npm run build && typeorm -d dist/database/data-source.js migration:show"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/typeorm": "^12.0.3",
    "@taskflow/shared": "^0.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "5.1.1",
    "supertest": "^7.0.0",
    "typescript": "~6.0.3",
    "vitest": "5.1.1"
  }
}
