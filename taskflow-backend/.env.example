# TaskFlow backend settings.
# Copy this file to `.env` and fill in your own values. Never commit `.env`.
# Every variable is checked at start-up; a missing or invalid one stops the app.

# development, test or production
NODE_ENV=development

# Port the API listens on (Vite proxies /api to it)
PORT=3000

# error, warn, info or debug
LOG_LEVEL=info

# Local MariaDB 11.4 (WampServer). Use 127.0.0.1 and port 3307, never 3306.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=taskflow
DB_USER=taskflow
DB_PASSWORD=change-me

# Encrypted connection to the database: false locally, true in production
DB_SSL=false
